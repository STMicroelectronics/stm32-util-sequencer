{{#with @root.sequencer_cxt~}}
{{#with additional~}}
/**
  * @brief  Initialize the Sequencer and register user tasks.
  */
void mx_seq_init(void)
{
  /* Sequencer initialization */
  SEQ_Init();

  /* Task registration */
{{#each tasks_configuration}}

  /* Register {{entry_function}} as a Sequencer task */
  SEQ_RegTask(MX_TASK_{{uppercase task_name}}, 0, {{lowercase entry_function}});
{{/each}}{{!tasks_configuration}}
}

/* Weak task function definitions --------------------------------------------*/

{{#each tasks_configuration~}}
__WEAK void {{lowercase entry_function}}(void)
{
  /* Task functions must return to allow the Sequencer to continue scheduling. */
  return;
}
{{/each}}{{!tasks_configuration}}{{/with}}{{!additional}}{{/with}}{{!sequencer_cxt}}
